{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/penyewaan_piknik/public/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/penyewaan_piknik/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/penyewaan_piknik/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/public/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/public/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*\\.(?:css|js|png|jpg|jpeg|webp|svg|ico|gif|woff|woff2|ttf|eot))$",
      "dest": "/$1"
    },
    {
      "src": "/penyewaan_piknik/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
